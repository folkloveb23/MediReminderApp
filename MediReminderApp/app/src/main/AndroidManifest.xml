<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ใช้เน็ต (OCR / Firebase / อื่น ๆ) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ ต้องขออนุญาตแจ้งเตือน (runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ตั้งนาฬิกาแบบ exact alarm (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- รับสัญญาณหลังรีบูต เพื่อ re-schedule แจ้งเตือน -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediReminderApp">

        <!-- Main entry -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MediReminderApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ถึงเวลายา → แสดง Notification -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- รีเฟรชตั้งปลุกทุกคืน 00:01 -->
        <receiver
            android:name=".MidnightRefreshReceiver"
            android:exported="false" />

        <!-- รีบูต/เปลี่ยนวัน/เวลา/โซน → ตั้งแจ้งเตือนใหม่ -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
